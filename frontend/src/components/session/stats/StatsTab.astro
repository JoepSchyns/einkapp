---
import StatsCharts from './StatsCharts.astro';
import StatsProblems from './StatsProblems.astro';
import StatsTables from './StatsTables.astro';
import StatsTiles from './StatsTiles.astro';
---

<section role="tabpanel" data-panel="stats" hidden class="session-stats">
  <div class="period" role="group" aria-label="Period">
    <button class="outline secondary" data-days="7">7 days</button>
    <button class="outline secondary" data-days="30">30 days</button>
    <button class="outline secondary" data-days="90">90 days</button>
  </div>

  <p id="statsEmpty" class="muted hidden">No images have been generated for this session in this period yet.</p>

  <div id="statsContent">
    <StatsTiles />
    <StatsProblems />
    <StatsCharts />
    <StatsTables />
    <p class="muted retention">Statistics are kept for 90 days.</p>
  </div>
</section>

<script>
  import { $ } from '../../../lib/dom';
  import { on, state } from '../sessionPage';
  import { current, days, loadStats, onStats } from './stats';

  const periodButtons = [...document.querySelectorAll<HTMLButtonElement>('.session-stats .period button')];

  function load(periodDays = days) {
    for (const btn of periodButtons) {
      const active = Number(btn.dataset.days) === periodDays;
      btn.classList.toggle('outline', !active);
      btn.classList.toggle('secondary', !active);
      btn.setAttribute('aria-pressed', String(active));
    }
    loadStats(periodDays);
  }

  periodButtons.forEach((btn) => btn.addEventListener('click', () => load(Number(btn.dataset.days))));

  onStats((stats) => {
    const empty = stats.totals.total === 0;
    $('statsEmpty').classList.toggle('hidden', !empty);
    $('statsContent').classList.toggle('hidden', empty);
  });

  // Load when the tab is opened, and again for every new image while it is open
  let active = false;
  document.addEventListener('tab:show', (e) => {
    active = (e as CustomEvent<string>).detail === 'stats';
    if (active && state.global) load();
  });
  // Opened through a #stats link before the session had loaded
  on('session', () => active && !current && load());
  on('image', () => active && load());
</script>

<style>
  .period {
    display: inline-flex;
    width: auto;
    margin-bottom: var(--pico-spacing);
  }

  .period button {
    padding: 0.3rem 0.9rem;
    font-size: 0.85rem;
  }

  /* Colour swatch for a source, used by the tables and the problems list */
  .session-stats :global(.swatch) {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    margin-right: 0.5rem;
  }

  .retention {
    text-align: center;
    font-size: 0.85rem;
  }
</style>
