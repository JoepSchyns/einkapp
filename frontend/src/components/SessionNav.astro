<nav>
  <ul>
    <li><strong>Sessions</strong> &nbsp;<span id="sessionCount"></span></li>
    <li><small id="refreshCountdown"></small></li>
  </ul>
  <ul>
    <li><button id="refreshBtn" class="outline">Refresh</button></li>
    <li><button id="createSessionBtn">Create Session</button></li>
    <li><button id="logoutBtn" class="outline secondary">Logout</button></li>
  </ul>
</nav>

<style>
  #refreshCountdown {
    color: var(--pico-muted-color);
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    nav {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }

    nav > ul:last-child {
      flex-wrap: wrap;
      justify-content: flex-end;
      column-gap: 0.25rem;
    }

    nav > ul:last-child > li > button {
      font-size: 0.8rem;
      padding: 0.35rem 0.6rem;
    }
  }
</style>
