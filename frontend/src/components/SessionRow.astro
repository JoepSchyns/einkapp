---
import CopyButton from './CopyButton.astro';
---

<template id="sessionRowTemplate">
  <tr class="session-row">
    <td class="id-cell">
      <code data-field="id"></code>
      <CopyButton dataField="copyBtn" />
    </td>
    <td data-field="date"></td>
    <td class="actions-cell">
      <a data-field="viewLink" class="arrow-link" aria-label="View session">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </a>
    </td>
  </tr>
</template>

<style is:global>
  .id-cell {
    white-space: nowrap;
  }

  code[data-field='id'] {
    display: inline-block;
    vertical-align: middle;
  }

  @media (max-width: 1200px) {
    code[data-field='id'] {
      max-width: 12ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .actions-cell {
    text-align: center;
  }

  .session-row {
    cursor: pointer;
  }

  .session-row:hover td {
    background-color: var(--pico-table-row-stripped-background-color, rgba(0,0,0,0.035));
  }

  .arrow-link {
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--pico-muted-color);
    padding: 0 0.25rem;
  }

  .arrow-link:hover {
    color: var(--pico-primary);
  }
</style>
