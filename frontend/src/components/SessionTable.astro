---
---

<template id="sessionRowTemplate">
  <tr>
    <td><code data-field="id"></code></td>
    <td data-field="date"></td>
    <td data-field="generator"></td>
    <td>
      <a data-field="infoLink" target="_blank" rel="noopener">Info</a>
      {' | '}
      <a data-field="imageLink" target="_blank" rel="noopener">Image</a>
    </td>
    <td>
      <a data-field="deleteBtn" href="#" role="button" class="delete-btn">Delete</a>
    </td>
  </tr>
</template>

<section id="adminSection">
  <nav>
    <ul>
      <li><strong>Sessions</strong> &nbsp;<span id="sessionCount"></span></li>
      <li><small id="refreshCountdown"></small></li>
    </ul>
    <ul>
      <li><button id="refreshBtn" class="outline">Refresh</button></li>
      <li><button id="createSessionBtn">Create Session</button></li>
      <li><button id="logoutBtn" class="outline secondary">Logout</button></li>
    </ul>
  </nav>
  <table>
    <thead>
      <tr>
        <th>Session ID</th>
        <th>Last Accessed</th>
        <th>Generator</th>
        <th>Links</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="sessionTable"></tbody>
  </table>
</section>

<script>
  interface Session {
    id: string;
    lastAccessedAt: string;
    generatorName?: string;
  }

  const REFRESH_INTERVAL_S = 30;
  const template = document.getElementById('sessionRowTemplate') as HTMLTemplateElement;
  const countdownEl = document.getElementById('refreshCountdown')!;
  let secondsLeft = REFRESH_INTERVAL_S;
  let autoRefreshTimer: ReturnType<typeof setInterval> | null = null;
  let countdownTimer: ReturnType<typeof setInterval> | null = null;

  // --- Rendering ---

  function renderSessions(sessions: Session[]) {
    const tbody = document.getElementById('sessionTable')!;
    document.getElementById('sessionCount')!.textContent = `${sessions.length} session(s)`;
    tbody.replaceChildren();

    if (sessions.length === 0) {
      const td = document.createElement('td');
      td.colSpan = 5;
      td.style.color = 'var(--pico-muted-color)';
      td.textContent = 'No active sessions.';
      const tr = document.createElement('tr');
      tr.appendChild(td);
      tbody.appendChild(tr);
      return;
    }

    for (const s of sessions) {
      const row = template.content.cloneNode(true) as DocumentFragment;
      const field = (name: string) => row.querySelector(`[data-field="${name}"]`)!;
      field('id').textContent = s.id;
      field('date').textContent = new Date(s.lastAccessedAt).toLocaleString();
      if (s.generatorName) {
        field('generator').textContent = s.generatorName;
      } else {
        (field('generator') as HTMLElement).style.color = 'var(--pico-muted-color)';
        field('generator').textContent = '—';
      }
      (field('infoLink') as HTMLAnchorElement).href = `/info/?id=${encodeURIComponent(s.id)}`;
      (field('imageLink') as HTMLAnchorElement).href = `/api/session/${encodeURIComponent(s.id)}/image`;
      (field('deleteBtn') as HTMLAnchorElement).dataset.deleteId = s.id;
      tbody.appendChild(row);
    }
  }

  // --- API ---

  async function fetchSessions(): Promise<Session[] | null> {
    const res = await fetch('/api/admin/sessions');
    return res.ok ? res.json() : null;
  }

  // --- Auto-refresh ---

  function startAutoRefresh() {
    clearInterval(autoRefreshTimer!);
    clearInterval(countdownTimer!);
    secondsLeft = REFRESH_INTERVAL_S;
    countdownEl.textContent = `Auto-refresh in ${secondsLeft}s`;
    countdownTimer = setInterval(() => {
      countdownEl.textContent = `Auto-refresh in ${--secondsLeft}s`;
    }, 1000);
    autoRefreshTimer = setInterval(async () => {
      const sessions = await fetchSessions();
      if (sessions) {
        renderSessions(sessions);
        secondsLeft = REFRESH_INTERVAL_S;
      } else {
        stopAutoRefresh();
        document.dispatchEvent(new CustomEvent('admin:unauthenticated'));
      }
    }, REFRESH_INTERVAL_S * 1000);
  }

  function stopAutoRefresh() {
    clearInterval(autoRefreshTimer!);
    clearInterval(countdownTimer!);
    autoRefreshTimer = countdownTimer = null;
    countdownEl.textContent = '';
  }

  // --- Helpers ---

  async function withBusy(btn: HTMLButtonElement, fn: () => Promise<void>) {
    btn.setAttribute('aria-busy', 'true');
    btn.disabled = true;
    try { await fn(); } finally {
      btn.removeAttribute('aria-busy');
      btn.disabled = false;
    }
  }

  // --- Button handlers ---

  document.getElementById('refreshBtn')!.addEventListener('click', (e) =>
    withBusy(e.currentTarget as HTMLButtonElement, async () => {
      const sessions = await fetchSessions();
      if (sessions) { renderSessions(sessions); startAutoRefresh(); }
      else { stopAutoRefresh(); document.dispatchEvent(new CustomEvent('admin:unauthenticated')); }
    })
  );

  document.getElementById('createSessionBtn')!.addEventListener('click', (e) =>
    withBusy(e.currentTarget as HTMLButtonElement, async () => {
      const res = await fetch('/api/admin/session', { method: 'POST' });
      if (res.ok) {
        const sessions = await fetchSessions();
        if (sessions) renderSessions(sessions);
      }
    })
  );

  document.getElementById('logoutBtn')!.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    stopAutoRefresh();
    document.dispatchEvent(new CustomEvent('admin:logout'));
  });

  document.getElementById('sessionTable')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-delete-id]');
    if (!btn) return;
    e.preventDefault();
    btn.setAttribute('aria-busy', 'true');
    await fetch(`/api/admin/session/${encodeURIComponent(btn.dataset.deleteId!)}`, { method: 'DELETE' });
    const sessions = await fetchSessions();
    if (sessions) renderSessions(sessions);
  });

  // --- External events ---

  document.addEventListener('admin:start-refresh', async () => {
    const sessions = await fetchSessions();
    if (sessions) { renderSessions(sessions); startAutoRefresh(); }
  });

  document.addEventListener('admin:stop-refresh', () => stopAutoRefresh());
</script>

<style>
  #refreshCountdown {
    color: var(--pico-muted-color);
    font-size: 0.8rem;
  }

  .delete-btn {
    font-size: 0.8rem;
    padding: 0.1rem 0.6rem;
    background-color: var(--pico-del-color);
    border-color: var(--pico-del-color);
    color: #fff;
  }

  .delete-btn:hover {
    filter: brightness(0.85);
  }
</style>
