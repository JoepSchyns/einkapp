---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '@picocss/pico';

  .page-header {
    text-align: center;
    padding-top: 2rem;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin-bottom: 0;
  }
</style>
