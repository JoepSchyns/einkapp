---
import EinkLayout from '../../layouts/EinkLayout.astro';
import InfoView from '../../components/InfoView.astro';
---

<EinkLayout title="Eink Info">
  <div id="exhibit">
    <div id="label-mount">
      <InfoView />
    </div>
  </div>
</EinkLayout>

<style>
  #exhibit {
    display: block;
  }

  #label-mount {
    width: fit-content;
  }

  @media (min-width: 400px) {
    #exhibit {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }

    #label-mount {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      border: 1px solid #e8e4df;
      border-radius: 2px;
    }
  }
</style>
