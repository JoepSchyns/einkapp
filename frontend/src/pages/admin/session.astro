---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import Tabs from '../../components/tabs/Tabs.astro';
import SessionHeader from '../../components/session/SessionHeader.astro';
import OverviewTab from '../../components/session/OverviewTab.astro';
import DisplaysTab from '../../components/session/DisplaysTab.astro';
import InfoDisplaysTab from '../../components/session/InfoDisplaysTab.astro';
import LinkBuilderTab from '../../components/session/LinkBuilderTab.astro';
import SettingsTab from '../../components/session/SettingsTab.astro';
import StatsTab from '../../components/session/stats/StatsTab.astro';

const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'displays', label: 'Displays', count: true },
  { id: 'info', label: 'Info displays', count: true },
  { id: 'link', label: 'Link builder' },
  { id: 'settings', label: 'Settings' },
  { id: 'stats', label: 'Statistics' },
];
---

<Layout title="Session">
  <AdminNav current="sessions" />

  <div id="loading">Loading…</div>

  <div id="notFound" class="hidden">
    <p>Session not found or you are not authenticated.</p>
    <a href="/admin/">Back to sessions</a>
  </div>

  <div id="sessionDetail" class="hidden">
    <SessionHeader />
    <Tabs label="Session" tabs={tabs} />
    <OverviewTab />
    <DisplaysTab />
    <InfoDisplaysTab />
    <LinkBuilderTab />
    <SettingsTab />
    <StatsTab />
  </div>
</Layout>

<script>
  import { startSessionPage } from '../../components/session/sessionPage';

  // The tab components listen to the shared page state
  startSessionPage();
</script>

<style>
  #sessionDetail {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Compact button for actions inside the tabs' lists and cards */
  #sessionDetail :global(.small-btn) {
    width: auto;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    margin: 0;
  }
</style>
